---
import Base from '@fce/shared/layouts/Base.astro';
import Nav from '@fce/shared/components/Nav.astro';
import Button from '@fce/shared/components/Button.astro';
import ComparisonTable from '@fce/shared/components/ComparisonTable.astro';

import CTA from '@fce/shared/components/CTA.astro';
import Footer from '@fce/shared/components/Footer.astro';

import DogfoodDemo from '../components/DogfoodDemo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Screenshots from '../components/Screenshots.astro';
import Founder from '../components/Founder.astro';
import FAQ from '../components/FAQ.astro';

import '../styles/theme.css';
---

<Base
  title="Mission Control — Stop Babysitting Your AI Agents"
  description="You're juggling worktrees, rerunning pipelines, and burning API tokens. Mission Control orchestrates your AI coding agents so you ship code, not manage processes. Uses your Anthropic subscription — no API bills."
  ogImage="/og-image.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Mission Control",
      "description": "SDLC control plane that orchestrates AI coding agents to produce auditable, policy-governed pull requests at scale",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "5000",
        "priceCurrency": "USD",
        "priceValidUntil": "2027-01-01"
      },
      "creator": {
        "@type": "Person",
        "name": "Sergey Kovalev",
        "url": "https://linkedin.com/in/skovalev"
      }
    })} />
  </Fragment>

  <Nav
    logo="Mission Control"
    links={[
      { text: "Demo", href: "#demo" },
      { text: "How It Works", href: "#how-it-works" },
      { text: "FAQ", href: "#faq" },
    ]}
    ctaText="Book a Demo →"
    ctaHref="https://calendly.com/skaskapro/30min"
  />

  <!-- 1. HERO — Problem-first -->
  <section class="relative overflow-hidden">
    <!-- Gradient background with cyan tint -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(6, 182, 212, 0.1) 0%, #08090C 70%);"></div>

    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div class="relative max-w-4xl mx-auto px-6 text-center pt-24 md:pt-32 pb-16">
      <p class="text-[var(--accent-primary)] font-mono text-sm tracking-wider mb-6 uppercase">
        Stop babysitting AI agents
      </p>

      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.08] tracking-tight">
        You code with AI.<br />
        <span class="text-[var(--text-secondary)]">But who manages the AI?</span>
      </h1>

      <p class="mt-8 max-w-2xl mx-auto text-lg md:text-xl text-[var(--text-muted)] leading-relaxed">
        Juggling worktrees. Rerunning pipelines. Babysitting agents that crash.
        Burning API tokens on boilerplate that Haiku could handle.
      </p>

      <p class="mt-6 text-xl md:text-2xl font-semibold text-[var(--accent-primary)]">
        Mission Control does all of that for you.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
        <Button href="#demo" variant="primary" size="lg">Watch the demo →</Button>
        <Button href="https://calendly.com/skaskapro/30min" variant="secondary" size="lg">Book a 30-min call</Button>
      </div>

      <!-- Subscription callout -->
      <p class="mt-6 text-xs text-[var(--text-muted)] font-mono tracking-wide">
        Works with your Anthropic subscription — no API token bills.
      </p>
    </div>

    <!-- Hero product screenshot — below hero text, not floating -->
    <div class="relative max-w-5xl mx-auto px-6 pb-24 md:pb-32">
      <div class="rounded-xl overflow-hidden border border-[var(--border)] shadow-2xl shadow-cyan-900/20">
        <img
          src="/screenshots/dashboard.png"
          alt="Mission Control Pipeline — real production dashboard"
          class="w-full h-auto"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. Dogfooding demo with video -->
  <section id="demo">
    <DogfoodDemo />
  </section>

  <!-- 3. Real product screenshots -->
  <Screenshots />

  <!-- 4. How it works -->
  <HowItWorks />

  <!-- 5. Comparison -->
  <ComparisonTable
    headline="You're doing too much manually."
    columns={["With Mission Control", "Without it"]}
    rows={[
      {
        label: "Workflow",
        values: [
          "Feed tasks, get auditable PRs. One dashboard.",
          "Juggle worktrees, switch folders, babysit each agent"
        ]
      },
      {
        label: "Cost",
        values: [
          "Uses your Anthropic subscription — no per-token API bills",
          "Burning API credits on every run, no cost control"
        ]
      },
      {
        label: "Model selection",
        values: [
          "Opus for architecture, Sonnet for features, Haiku for boilerplate — automatic",
          "One model for everything, overpaying for simple tasks"
        ]
      },
      {
        label: "When agents crash",
        values: [
          "Temporal auto-retries, recovers state, escalates if needed",
          "Lost work, manual restart, figure out what went wrong"
        ]
      },
      {
        label: "Scale",
        values: [
          "Parallel agents, hundreds of PRs, zero babysitting",
          "One agent, one task, wait for it to finish"
        ]
      },
      {
        label: "Audit trail",
        values: [
          "Full evidence bundle on every PR — task spec, reasoning, gates passed",
          "\"The AI wrote it\" — good luck explaining that"
        ]
      },
    ]}
  />

  <!-- 6. Founder credibility -->
  <Founder />

  <!-- 7. Beta access -->
  <section id="access" class="py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="inline-block bg-cyan-500/10 text-[var(--accent-primary)] text-xs font-mono px-4 py-1.5 rounded-full border border-cyan-500/20 mb-6">
        PRIVATE BETA
      </span>
      <h2 class="text-3xl md:text-5xl font-bold">Ship like a team of ten.<br />Pay like a team of one.</h2>
      <p class="text-[var(--text-secondary)] mt-4 text-lg max-w-2xl mx-auto">
        Mission Control is in private beta. Limited spots. Uses your Anthropic subscription — no API token bills on top.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12 max-w-3xl mx-auto text-left">
        <!-- Beta access card -->
        <div class="p-8 rounded-xl border border-[var(--accent-primary)]/30 bg-[var(--bg-secondary)] relative">
          <div class="absolute -top-3 left-6">
            <span class="bg-[var(--accent-primary)] text-black text-xs font-bold px-3 py-1 rounded-full">LIMITED SPOTS</span>
          </div>
          <h3 class="text-xl font-bold mt-2">Private Beta</h3>
          <p class="text-[var(--text-muted)] text-sm mt-1 mb-4">For solo CTOs and small teams</p>
          <ul class="space-y-3 text-sm text-[var(--text-secondary)]">
            <li class="flex gap-2"><span class="text-[var(--accent-primary)]">&#10003;</span> Full MC instance on your infra</li>
            <li class="flex gap-2"><span class="text-[var(--accent-primary)]">&#10003;</span> Policy engine + model routing</li>
            <li class="flex gap-2"><span class="text-[var(--accent-primary)]">&#10003;</span> Evidence bundles on every PR</li>
            <li class="flex gap-2"><span class="text-[var(--accent-primary)]">&#10003;</span> Direct access to me for setup</li>
            <li class="flex gap-2"><span class="text-[var(--accent-primary)]">&#10003;</span> Works with your Anthropic subscription</li>
          </ul>
          <a href="https://calendly.com/skaskapro/30min"
            class="block mt-6 text-center bg-[var(--accent-primary)] text-black font-semibold px-6 py-3 rounded-lg hover:opacity-90 transition-opacity">
            Request access →
          </a>
        </div>

        <!-- Free for OSS card -->
        <div class="p-8 rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)]">
          <h3 class="text-xl font-bold">Free for Open Source</h3>
          <p class="text-[var(--text-muted)] text-sm mt-1 mb-4">Give back to the community</p>
          <ul class="space-y-3 text-sm text-[var(--text-secondary)]">
            <li class="flex gap-2"><span class="text-[var(--color-success)]">&#10003;</span> Full MC — no feature gates</li>
            <li class="flex gap-2"><span class="text-[var(--color-success)]">&#10003;</span> Public repos only</li>
            <li class="flex gap-2"><span class="text-[var(--color-success)]">&#10003;</span> Self-hosted, self-managed</li>
            <li class="flex gap-2"><span class="text-[var(--color-success)]">&#10003;</span> Community support</li>
            <li class="flex gap-2"><span class="text-[var(--color-success)]">&#10003;</span> We may feature your project as a case study</li>
          </ul>
          <a href="https://calendly.com/skaskapro/30min"
            class="block mt-6 text-center border border-[var(--border)] hover:border-[var(--border-hover)] text-[var(--text-primary)] font-semibold px-6 py-3 rounded-lg transition-colors">
            Apply for OSS access →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <FAQ />

  <!-- 9. Final CTA -->
  <CTA
    headline="See Mission Control build itself. Live."
    subheadline="30-minute demo. I screen-share MC running on its own codebase — real PRs, real policy gates, real evidence bundles. Not slides."
    buttonText="Book a demo →"
    buttonHref="https://calendly.com/skaskapro/30min"
  />

  <div class="text-center pb-8">
    <p class="text-sm text-[var(--text-muted)]">
      Or email directly: <a href="mailto:sergey@misco.dev" class="text-[var(--accent-primary)] hover:underline">sergey@misco.dev</a>
    </p>
  </div>

  <Footer
    productName="Mission Control"
    companyName="Sergey Kovalev"
    links={[
      { text: "sergey@misco.dev", href: "mailto:sergey@misco.dev" },
      { text: "Twitter", href: "https://twitter.com/sergeyk0" },
      { text: "LinkedIn", href: "https://linkedin.com/in/skovalev" },
      { text: "YouTube", href: "https://youtube.com/@skovalev" },
      { text: "Instagram", href: "https://instagram.com/skaskapro" },
    ]}
  />
</Base>

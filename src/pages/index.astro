---
import Base from '@fce/shared/layouts/Base.astro';
import Nav from '@fce/shared/components/Nav.astro';
import Button from '@fce/shared/components/Button.astro';
import ComparisonTable from '@fce/shared/components/ComparisonTable.astro';
import PricingTable from '@fce/shared/components/PricingTable.astro';
import CTA from '@fce/shared/components/CTA.astro';
import Footer from '@fce/shared/components/Footer.astro';

import DogfoodDemo from '../components/DogfoodDemo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Screenshots from '../components/Screenshots.astro';
import Founder from '../components/Founder.astro';
import FAQ from '../components/FAQ.astro';

import '../styles/theme.css';
---

<Base
  title="Mission Control — AI Coding at Scale, Governed"
  description="Your AI agents write thousands of lines. Can you explain any of them to an auditor? Mission Control governs AI coding fleets with policy gates, evidence bundles, and intelligent model routing."
  ogImage="/og-image.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Mission Control",
      "description": "SDLC control plane that orchestrates AI coding agents to produce auditable, policy-governed pull requests at scale",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "5000",
        "priceCurrency": "USD",
        "priceValidUntil": "2027-01-01"
      },
      "creator": {
        "@type": "Person",
        "name": "Sergey Kovalev",
        "url": "https://linkedin.com/in/sergeyko"
      }
    })} />
  </Fragment>

  <Nav
    logo="Mission Control"
    ctaText="Book a Demo →"
    ctaHref="https://calendly.com/skaskapro/30min"
  />

  <!-- 1. HERO — Problem-first -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Gradient background with cyan tint -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(6, 182, 212, 0.08) 0%, #08090C 70%);"></div>

    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div class="relative max-w-5xl mx-auto px-6 text-center py-32">
      <p class="text-[var(--accent-primary)] font-mono text-sm tracking-wider mb-8 uppercase">
        SDLC Control Plane
      </p>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-[1.1] tracking-tight">
        Your AI agents wrote<br />
        <span class="text-[var(--text-secondary)]">10,000 lines last week.</span>
      </h1>

      <div class="mt-8 space-y-2 text-lg md:text-xl text-[var(--text-muted)]">
        <p>Can you explain any of them to an auditor?</p>
        <p>Can you prove which policy gates they passed?</p>
        <p>Can you even tell which model wrote what?</p>
      </div>

      <p class="mt-8 text-2xl md:text-3xl font-semibold text-[var(--accent-primary)]">
        Mission Control can.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
        <Button href="#demo" variant="primary" size="lg">Watch the demo →</Button>
        <Button href="https://calendly.com/skaskapro/30min" variant="secondary" size="lg">Book a 30-min call</Button>
      </div>
    </div>

    <!-- Hero product screenshot — floating below -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-5xl px-6 translate-y-1/3">
      <div class="rounded-xl overflow-hidden border border-[var(--border)] shadow-2xl shadow-cyan-900/20">
        <img
          src="/screenshots/dashboard.png"
          alt="Mission Control Pipeline — real production dashboard"
          class="w-full h-auto"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Spacer for the overflowing hero screenshot -->
  <div class="h-48 md:h-64"></div>

  <!-- 2. Dogfooding demo with video -->
  <section id="demo">
    <DogfoodDemo />
  </section>

  <!-- 3. Real product screenshots -->
  <Screenshots />

  <!-- 4. How it works -->
  <HowItWorks />

  <!-- 5. Comparison -->
  <ComparisonTable
    headline="AI coding without governance is just technical debt at scale."
    columns={["With Mission Control", "Without Mission Control"]}
    rows={[
      {
        label: "Code quality",
        values: [
          "Policy gates enforce consistent standards on every PR",
          "Varies wildly between agents and prompts"
        ]
      },
      {
        label: "Audit trail",
        values: [
          "Full evidence bundle: task spec, reasoning, gates passed",
          "\"The AI wrote it\" — good luck explaining that to auditors"
        ]
      },
      {
        label: "Model costs",
        values: [
          "Risk-tier routing: Opus for hard problems, Haiku for easy ones",
          "One model for everything, burning budget on boilerplate"
        ]
      },
      {
        label: "Reliability",
        values: [
          "Temporal workflows: automatic retry, state recovery, escalation",
          "Agent crashes = lost work, manual restart"
        ]
      },
      {
        label: "Scale",
        values: [
          "Parallel fleets, hundreds of PRs, one dashboard",
          "One agent, one task, one developer babysitting"
        ]
      },
      {
        label: "Security",
        values: [
          "Sandboxed Coder instances, zero production access",
          "Agents with production access, shared environments"
        ]
      },
    ]}
  />

  <!-- 6. Founder credibility -->
  <Founder />

  <!-- 7. Pricing -->
  <PricingTable
    headline="Ship like a team of ten. Pay like a team of one."
    subheadline="Start with a pilot. Scale when you see the numbers. Cancel monthly."
    tiers={[
      {
        name: "Pilot",
        price: "$5K",
        description: "flat — Prove it works on your codebase",
        features: [
          "2-week hands-on engagement",
          "MC deployed on your repo",
          "First 20 PRs together",
          "Success criteria defined upfront",
          "Walk away if the numbers don't work",
        ],
        cta: { text: "Start a pilot →", href: "https://calendly.com/skaskapro/30min" },
      },
      {
        name: "Solo",
        price: "$1-2K",
        description: "per month — For technical leaders shipping alone",
        features: [
          "Self-hosted MC instance",
          "Single repo, full policy engine",
          "Intelligent model routing",
          "Evidence bundles on every PR",
          "Ongoing updates",
        ],
        cta: { text: "Get started →", href: "https://calendly.com/skaskapro/30min" },
        highlighted: true,
      },
      {
        name: "Team",
        price: "$3-5K",
        description: "per month — For teams of 3-8 shipping at scale",
        features: [
          "Multi-repo support",
          "Team access and permissions",
          "Priority support",
          "Quarterly review and optimization",
          "Custom policy templates",
        ],
        cta: { text: "Talk to me →", href: "https://calendly.com/skaskapro/30min" },
      },
    ]}
  />

  <!-- 8. FAQ -->
  <FAQ />

  <!-- 9. Final CTA -->
  <CTA
    headline="See Mission Control build itself. Live."
    subheadline="30-minute demo. I screen-share MC running on its own codebase — real PRs, real policy gates, real evidence bundles. Not slides."
    buttonText="Book a demo →"
    buttonHref="https://calendly.com/skaskapro/30min"
  />

  <div class="text-center -mt-16 pb-16">
    <p class="text-sm text-[var(--text-muted)]">
      Or email directly: <a href="mailto:sergey@kovalev.dev" class="text-[var(--accent-primary)] hover:underline">sergey@kovalev.dev</a>
    </p>
  </div>

  <Footer
    productName="Mission Control"
    companyName="Sergey Kovalev"
    links={[
      { text: "sergey@kovalev.dev", href: "mailto:sergey@kovalev.dev" },
      { text: "Twitter", href: "https://twitter.com/AISergeyK" },
      { text: "LinkedIn", href: "https://linkedin.com/in/sergeyko" },
      { text: "GitHub", href: "https://github.com/sergey-ko" },
    ]}
  />
</Base>
